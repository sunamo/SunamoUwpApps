<UserControl x:Class="apps.SelectFile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <!--<Border x:Name="border" Background="White" BorderThickness="2">-->
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="tbSelectedFile"></TextBlock>
            
            <Button x:Name="btnSelectFile" Content="Select" Margin="10" Click="btnSelectFile_Click"></Button>
            
        </StackPanel>
    <!--</Border>-->
</UserControl>
