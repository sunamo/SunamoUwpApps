<UserControl
    x:Class="apps.PopupButtons"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:apps"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <StackPanel Orientation="Horizontal" x:Name="sp">
        <Button x:FieldModifier="public" x:Name="btnOk" Content="OK" Grid.Column="1" Click="btnOk_Click" IsEnabled="False" Margin="10"></Button>
        <Button x:FieldModifier="public" x:Name="btnCancel" Content="Cancel" Grid.Column="2" Click="btnCancel_Click" Margin="10" Visibility="Collapsed"></Button>
        <Button x:FieldModifier="public" x:Name="btnApply" Content="Apply" Grid.Column="3" Click="btnApply_Click" Margin="10" IsEnabled="False" Visibility="Collapsed"></Button>
    </StackPanel>
    
